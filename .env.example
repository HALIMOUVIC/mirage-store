# ==========================================
# Mirage Store - Environment Configuration Template
# ==========================================

PORT=3000
NODE_ENV=production
BASE_URL=https://yourstore.com
JWT_SECRET=your_super_secret_jwt_key_2026

# Tebex Headless API Credentials
TEBEX_PUBLIC_TOKEN=your_tebex_public_token_here
TEBEX_PRIVATE_KEY=your_tebex_private_key_here
TEBEX_WEBHOOK_SECRET=your_tebex_webhook_secret_here
TEBEX_SERVER_SECRET=your_game_server_secret_key_here
TEBEX_PROJECT_ID=1665273
NOTARY_PACKAGE_ID=7642742

# Admin Security PIN
ADMIN_PIN=change_this_to_a_secure_pin

# Discord Webhook (Optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here

# Rate Limiting Settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
